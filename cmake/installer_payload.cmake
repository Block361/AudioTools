file(STRINGS "${MANIFEST}" entries ENCODING UTF-8)
if(NOT DEFINED ICON)
  set(ICON "${SOURCE_ROOT}/src/native/assets/openaoip.ico")
endif()
set(result "#include <windows.h>\n1 ICON \"${ICON}\"\n1 RT_MANIFEST \"${SOURCE_ROOT}/src/native/app.manifest\"\n")
set(index 1000)
set(manifest_text "")
foreach(entry IN LISTS entries)
  string(REPLACE "|" ";" parts "${entry}")
  list(GET parts 0 source)
  list(GET parts 1 target)
  if(NOT EXISTS "${source}")
    message(FATAL_ERROR "Installer payload missing: ${source}")
  endif()
  string(APPEND result "${index} RCDATA \"${source}\"\n")
  string(APPEND manifest_text "${target}|${index}\n")
  math(EXPR index "${index}+1")
endforeach()
get_filename_component(folder "${OUTPUT}" DIRECTORY)
file(WRITE "${folder}/files.txt" "${manifest_text}")
string(APPEND result "100 RCDATA \"${folder}/files.txt\"\n")
file(WRITE "${OUTPUT}" "${result}")
