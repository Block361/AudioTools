# Separate product package. The IoT daemon is never added to the Windows Suite installer.
if(NOT UNIX OR APPLE)
  return()
endif()
install(TARGETS openaoip_iot RUNTIME DESTINATION bin COMPONENT IoT)
install(FILES IOT.md LICENSE THIRD_PARTY.md DESTINATION . COMPONENT IoT)
install(FILES deploy/iot/install.sh deploy/iot/openaoip-iot.service DESTINATION deploy COMPONENT IoT)
install(FILES examples/iot-audio.json DESTINATION examples COMPONENT IoT)
install(FILES third_party/LICENSE-httplib.txt third_party/LICENSE-json.txt third_party/LICENSE-miniaudio.txt
  DESTINATION licenses COMPONENT IoT)
install(FILES PTP.md DESTINATION . COMPONENT IoT)
install(FILES WINDOWS-START.md WINDOWS-AUDIO.md ARCHITECTURE.md DESTINATION . COMPONENT IoT)
set(CPACK_GENERATOR TGZ)
set(CPACK_COMPONENTS_ALL IoT)
set(CPACK_PACKAGE_NAME OpenAoIP-IoT)
set(CPACK_PACKAGE_VERSION 0.1.0)
set(CPACK_PACKAGE_FILE_NAME "OpenAoIP-IoT-0.1.0-Linux-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_COMPONENT_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_ARCHIVE_IOT_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}")
