build openaoip-iot: CXX_EXECUTABLE_LINKER__openaoip_iot_Release CMakeFiles/openaoip_iot.dir/src/iot_main.cpp.o | libaoip_iot.a libaoip_bridge_engine.a libaoip_session.a libaoip_clock.a libaoip_config.a libaoip_core.a libaoip_network.a libaoip_audio.a libaoip_miniaudio.a || libaoip_audio.a libaoip_bridge_engine.a libaoip_clock.a libaoip_config.a libaoip_core.a libaoip_iot.a libaoip_miniaudio.a libaoip_network.a libaoip_session.a
  CONFIG = Release
  DEP_FILE = CMakeFiles/openaoip_iot.dir/link.d
  FLAGS = -O3 -DNDEBUG
  LINK_FLAGS = -Wl,--dependency-file=CMakeFiles/openaoip_iot.dir/link.d
  LINK_LIBRARIES = libaoip_iot.a  libaoip_bridge_engine.a  libaoip_session.a  libaoip_clock.a  libaoip_config.a  libaoip_core.a  libaoip_network.a  libaoip_audio.a  libaoip_miniaudio.a  -ldl
  OBJECT_DIR = CMakeFiles/openaoip_iot.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = openaoip-iot
  TARGET_PDB = openaoip-iot.dbg
  TARGET_SUPPORT_DIR = CMakeFiles/openaoip_iot.dir

# =============================================================================
# Object build statements for EXECUTABLE target openaoip


#############################################
# Order-only phony target for openaoip

build cmake_object_order_depends_target_openaoip: phony || cmake_object_order_depends_target_aoip_audio cmake_object_order_depends_target_aoip_core cmake_object_order_depends_target_aoip_miniaudio cmake_object_order_depends_target_aoip_network

build CMakeFiles/openaoip.dir/src/main.cpp.o: CXX_COMPILER__openaoip_unscanned_Release /src/src/main.cpp || cmake_object_order_depends_target_openaoip
  CONFIG = Release
  DEFINES = -DCPPHTTPLIB_THREAD_POOL_COUNT=4
  DEP_FILE = CMakeFiles/openaoip.dir/src/main.cpp.o.d
  FLAGS = -O3 -DNDEBUG -std=c++20
  INCLUDES = -I/src/include -isystem /src/third_party
  OBJECT_DIR = CMakeFiles/openaoip.dir
  OBJECT_FILE_DIR = CMakeFiles/openaoip.dir/src
  TARGET_SUPPORT_DIR = CMakeFiles/openaoip.dir


# =============================================================================
# Link build statements for EXECUTABLE target openaoip


#############################################
# Link the executable openaoip

build openaoip: CXX_EXECUTABLE_LINKER__openaoip_Release CMakeFiles/openaoip.dir/src/main.cpp.o | libaoip_core.a libaoip_network.a libaoip_audio.a libaoip_miniaudio.a || libaoip_audio.a libaoip_core.a libaoip_miniaudio.a libaoip_network.a
  CONFIG = Release
  DEP_FILE = CMakeFiles/openaoip.dir/link.d
  FLAGS = -O3 -DNDEBUG
  LINK_FLAGS = -Wl,--dependency-file=CMakeFiles/openaoip.dir/link.d
  LINK_LIBRARIES = libaoip_core.a  libaoip_network.a  libaoip_audio.a  libaoip_miniaudio.a  -ldl
  OBJECT_DIR = CMakeFiles/openaoip.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = openaoip
  TARGET_PDB = openaoip.dbg
  TARGET_SUPPORT_DIR = CMakeFiles/openaoip.dir


#############################################
# Utility command for openaoip_web

build openaoip_web: phony CMakeFiles/openaoip_web openaoip


#############################################
# Utility command for package

build CMakeFiles/package.util: CUSTOM_COMMAND all
  COMMAND = cd /src/build/iot-arm64 && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build package: phony CMakeFiles/package.util


#############################################
# Utility command for package_source

build CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /src/build/iot-arm64 && /usr/bin/cpack --config ./CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build package_source: phony CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /src/build/iot-arm64 && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /src/build/iot-arm64 && /usr/bin/cmake --regenerate-during-build -S/src -B/src/build/iot-arm64
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build list_install_components: phony


#############################################
# Utility command for install

build CMakeFiles/install.util: CUSTOM_COMMAND all
  COMMAND = cd /src/build/iot-arm64 && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build install: phony CMakeFiles/install.util


#############################################
# Utility command for install/local

build CMakeFiles/install/local.util: CUSTOM_COMMAND all
  COMMAND = cd /src/build/iot-arm64 && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build install/local: phony CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build CMakeFiles/install/strip.util: CUSTOM_COMMAND all
  COMMAND = cd /src/build/iot-arm64 && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build install/strip: phony CMakeFiles/install/strip.util


#############################################
# Custom command for CMakeFiles/openaoip_web

build CMakeFiles/openaoip_web | ${cmake_ninja_workdir}CMakeFiles/openaoip_web: CUSTOM_COMMAND openaoip || libaoip_audio.a libaoip_core.a libaoip_miniaudio.a libaoip_network.a openaoip
  COMMAND = cd /src/build/iot-arm64 && /usr/bin/cmake -E copy_directory /src/web /src/build/iot-arm64/web
  DESC = Copying controller web assets

# =============================================================================
# Target aliases.

build aoip_audio: phony libaoip_audio.a

build aoip_bridge_engine: phony libaoip_bridge_engine.a

build aoip_clock: phony libaoip_clock.a

build aoip_config: phony libaoip_config.a

build aoip_core: phony libaoip_core.a

build aoip_iot: phony libaoip_iot.a

build aoip_miniaudio: phony libaoip_miniaudio.a

build aoip_network: phony libaoip_network.a

build aoip_session: phony libaoip_session.a

build openaoip_iot: phony openaoip-iot

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: /src/build/iot-arm64

build all: phony libaoip_miniaudio.a libaoip_audio.a libaoip_network.a libaoip_clock.a libaoip_core.a libaoip_session.a libaoip_config.a libaoip_bridge_engine.a libaoip_iot.a openaoip-iot openaoip openaoip_web

