cmake_minimum_required(VERSION 3.20)
project(OpenAoIPASIO VERSION 0.5.0 LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
add_library(OpenAoIPASIO64 SHARED driver/openaoip_asio.cpp driver/openaoip_asio.def src/virtual_bridge.cpp)
target_include_directories(OpenAoIPASIO64 PRIVATE include sdk driver)
target_compile_definitions(OpenAoIPASIO64 PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX UNICODE _UNICODE)
target_compile_options(OpenAoIPASIO64 PRIVATE /utf-8 /EHsc)
target_link_libraries(OpenAoIPASIO64 PRIVATE ole32 shell32 advapi32 uuid)
set_target_properties(OpenAoIPASIO64 PROPERTIES PREFIX "")
